<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobNow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            /* Set màu nền toàn web chuẩn Figma */
            body {
                background-color: #FAF4F0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }
            /* Style cho Header/Navbar */
            .jn-header {
                background-color: #12213F; /* Màu xanh đen đậm */
            }

            .jn-nav-link {
                color: #d1d5db !important;
                font-weight: 500;
                margin: 0 10px;
            }

                .jn-nav-link:hover, .jn-nav-link.active {
                    color: #ffffff !important;
                    border-bottom: 2px solid #ffffff;
                }
            /* Nút Register màu cam */
            .btn-register {
                background-color: #F97316;
                color: white;
                font-weight: bold;
                border: none;
            }

                .btn-register:hover {
                    background-color: #ea580c;
                    color: white;
                }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG (NAVBAR) -->
    <header>
        <nav class="navbar navbar-expand-lg jn-header py-3">
            <div class="container">
                <!-- Logo -->
                <a class="navbar-brand text-white fw-bold fs-3" asp-area="" asp-controller="Home" asp-action="Index">
                    Job<span class="text-white">Now</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse justify-content-between" id="navbarNav">
                    <!-- Các tab menu -->
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item">
                            <a class="nav-link jn-nav-link active" asp-area="" asp-controller="Home" asp-action="Index">Trang Chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jn-nav-link" asp-controller="Job" asp-action="Index">Tìm Việc</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jn-nav-link" asp-controller="Course" asp-action="Index">Khóa Học</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jn-nav-link" asp-controller="Notification" asp-action="Index">Thông Báo</a>
                        </li>
                        <!-- MERGE DECISION: Both branches added a nav item to the same <li> slot.
                             Upstream (Profile branch) added "Cá Nhân" -> ProfileController.
                             Stash (Employer branch) added "Nhà Tuyển Dụng" -> EmployerController.
                             These are two independent features with no logical conflict.
                             Decision: Keep BOTH as separate <li> items. -->
                        <li class="nav-item">
                            <a class="nav-link jn-nav-link" asp-controller="Profile" asp-action="Index">Cá Nhân</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link jn-nav-link" asp-controller="Employer" asp-action="Index">Nhà Tuyển Dụng</a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link jn-nav-link text-warning" asp-controller="Admin" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>

                    <!-- Nhóm nút Đăng nhập / Đăng ký / Thông tin cá nhân -->
                    <div class="d-flex align-items-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Profile" asp-action="Index" class="text-white text-decoration-none me-3 fw-bold d-flex align-items-center">
                                <i class="bi bi-person-circle fs-5 me-1 text-warning"></i> @User.Identity.Name
                            </a>
                            <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">Đăng Xuất</a>
                        }
                        else
                        {
                            <a asp-controller="Auth" asp-action="Login" class="text-white text-decoration-none me-3 fw-bold">Login</a>
                            <a asp-controller="Auth" asp-action="Register" class="btn btn-register px-4 rounded-pill">Register</a>
                        }
                        <i class="bi bi-bell text-white ms-3"></i> <!-- Icon chuông -->
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- PHẦN NỘI DUNG CHÍNH -->
    <!-- Bỏ class "container" ở đây để màu xanh của Banner Trang chủ được tràn viền 100% -->
    <main role="main">
        @RenderBody()
    </main>

    <!-- FOOTER
         MERGE DECISION: The original outer <footer> (old CareerFlow 3-column design, lines 117-149)
         was a duplicate / legacy version nested inside itself — invalid HTML.
         The inner <footer> (new JobNow 4-column design) is the newer, richer version.
         Decision: Remove the outer wrapper, keep only the inner 4-column footer. -->
    <footer class="jn-header pt-5 pb-3 mt-5 border-top border-secondary">
        <div class="container">
            <div class="row text-start mb-5">
                <!-- Cột 1: Logo và mô tả -->
                <div class="col-md-3 pe-4">
                    <h4 class="text-white fw-bold mb-3">JobNow</h4>
                    <p class="small text-secondary" style="line-height: 1.8;">Cầu nối vững chắc giữa nhân tài và doanh nghiệp hàng đầu Việt Nam. Nâng tầm sự nghiệp của bạn ngay hôm nay.</p>
                    <div class="d-flex gap-3 mt-3 text-secondary">
                        <i class="fs-5">👦</i>
                        <i class="fs-5">🧑‍💻</i>
                        <i class="fs-5">🌐</i>
                    </div>
                </div>

                <!-- Cột 2: Về JobNow -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-4" style="color: #94a3b8;">Về JobNow</h6>
                    <ul class="list-unstyled small" style="line-height: 2.2;">
                        <li><a href="#" class="text-secondary text-decoration-none">Về chúng tôi</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Liên hệ</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Góc báo chí</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Cơ hội nghề nghiệp</a></li>
                    </ul>
                </div>

                <!-- Cột 3: Dành cho ứng viên -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-4" style="color: #94a3b8;">Dành cho ứng viên</h6>
                    <ul class="list-unstyled small" style="line-height: 2.2;">
                        <li><a href="#" class="text-secondary text-decoration-none">Tìm việc làm</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Tạo CV trực tuyến</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Cẩm nang nghề nghiệp</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>

                <!-- Cột 4: Dành cho nhà tuyển dụng -->
                <div class="col-md-3">
                    <h6 class="fw-bold mb-4" style="color: #94a3b8;">Dành cho nhà tuyển dụng</h6>
                    <ul class="list-unstyled small" style="line-height: 2.2;">
                        <li><a href="#" class="text-secondary text-decoration-none">Đăng tin tuyển dụng</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Tìm kiếm hồ sơ</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Giải pháp HR</a></li>
                        <li><a href="#" class="text-secondary text-decoration-none">Bảng giá dịch vụ</a></li>
                    </ul>
                </div>
            </div>

            <hr class="border-secondary mb-4" style="opacity: 0.3;" />

            <div class="d-flex justify-content-end align-items-center">
                <p class="text-secondary small mb-0 me-4">&copy; 2026 Jobnow Inc. All rights reserved.</p>
                <a href="#" class="text-secondary small text-decoration-none me-3">Terms of Service</a>
                <a href="#" class="text-secondary small text-decoration-none">Privacy Policy</a>
            </div>
        </div>
    </footer>

    <!-- MERGE DECISION: Upstream had the full script block: jQuery + Bootstrap + site.js + Scripts section.
         Stash only had Bootstrap + Scripts section — a partial edit that accidentally dropped jQuery and site.js.
         Decision: Keep upstream's complete, correct script block. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
