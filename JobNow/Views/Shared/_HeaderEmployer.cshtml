@using System.Security.Claims
@using JobNow.Models
@inject Supabase.Client _supabase
@{
    int tokenBalance = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userId = User.FindFirstValue(ClaimTypes.NameIdentifier);
        try {
            var employer = await _supabase.From<Employer>().Where(e => e.ProfileId == userId).Single();
            if (employer != null) {
                var token = await _supabase.From<EmployerToken>().Where(t => t.EmployerId == employer.Id).Single();
                if (token != null) tokenBalance = token.Balance;
            }
        } catch { }
    }
}
<header>
    <nav class="navbar navbar-expand-lg jn-header py-3" style="background-color: #0f172a;">
        <div class="container-fluid px-4">
            <!-- Logo -->
            <a class="navbar-brand text-white fw-bold fs-4 d-flex align-items-center" asp-area="" asp-controller="Employer" asp-action="Index">
                <i class="bi bi-briefcase-fill text-warning me-2"></i> Job<span class="text-white">Now</span> <span class="ms-2 badge bg-warning text-dark" style="font-size: 0.6rem; vertical-align: middle;">EMPLOYER</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavEmployer" aria-controls="navbarNavEmployer" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-between" id="navbarNavEmployer">
                <!-- Các tab menu của Employer -->
                <ul class="navbar-nav ms-4">
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Employer" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Employer" asp-action="MyJobs">Jobs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Employer" asp-action="MyCourses">Courses</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Employer" asp-action="Applicants">Applicants</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Notification" asp-action="Index">Notifications</a>
                    </li>
                </ul>

                <!-- Nhóm nút góc phải -->
                <div class="d-flex align-items-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Employer" asp-action="Wallet" class="btn btn-outline-warning rounded-pill px-3 me-3 fw-bold">
                            🪙 Token: @tokenBalance
                        </a>
                        <a asp-controller="Profile" asp-action="Index" class="text-white text-decoration-none me-3 fw-bold d-flex align-items-center">
                            <i class="bi bi-person-circle fs-5 me-1 text-warning"></i> @User.Identity.Name
                        </a>
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">Logout</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
