<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - JobNow</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            /* Set màu nền toàn web chuẩn Figma */
            body {
                background-color: #FAF4F0;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }
            /* Style cho Header/Navbar */
            .jn-header {
                background-color: #12213F; /* Màu xanh đen đậm */
            }

            .jn-nav-link {
                color: #d1d5db !important;
                font-weight: 500;
                margin: 0 10px;
            }

                .jn-nav-link:hover, .jn-nav-link.active {
                    color: #ffffff !important;
                    border-bottom: 2px solid #ffffff;
                }
            /* Nút Register màu cam */
            .btn-register {
                background-color: #F97316;
                color: white;
                font-weight: bold;
                border: none;
            }

                .btn-register:hover {
                    background-color: #ea580c;
                    color: white;
                }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- THANH ĐIỀU HƯỚNG (NAVBAR) -->
    @await Html.PartialAsync("_HeaderAdmin")

    <!-- PHẦN NỘI DUNG CHÍNH -->
    <!-- Bỏ class "container" ở đây để màu xanh của Banner Trang chủ được tràn viền 100% -->
    <main role="main">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm m-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm m-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @RenderBody()
    </main>

    <!-- FOOTER
         MERGE DECISION: The original outer <footer> (old CareerFlow 3-column design, lines 117-149)
         was a duplicate / legacy version nested inside itself — invalid HTML.
         The inner <footer> (new JobNow 4-column design) is the newer, richer version.
         Decision: Remove the outer wrapper, keep only the inner 4-column footer. -->
    

    <!-- MERGE DECISION: Upstream had the full script block: jQuery + Bootstrap + site.js + Scripts section.
         Stash only had Bootstrap + Scripts section — a partial edit that accidentally dropped jQuery and site.js.
         Decision: Keep upstream's complete, correct script block. -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
