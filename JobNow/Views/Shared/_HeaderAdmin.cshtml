<header>
    <nav class="navbar navbar-expand-lg jn-header py-3" style="background-color: #581c87;"> <!-- Màu tím cho Admin -->
        <div class="container-fluid px-4">
            <!-- Logo -->
            <a class="navbar-brand text-white fw-bold fs-4 d-flex align-items-center" asp-area="" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-shield-lock-fill text-warning me-2"></i> Job<span class="text-white">Now</span> <span class="ms-2 badge bg-warning text-dark" style="font-size: 0.6rem; vertical-align: middle;">ADMIN</span>
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAdmin" aria-controls="navbarNavAdmin" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse justify-content-between" id="navbarNavAdmin">
                <!-- Các tab menu của Admin -->
                <ul class="navbar-nav ms-4">
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Admin" asp-action="Index">Dashboard</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Admin" asp-action="Users">Users</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Admin" asp-action="Employers">Employers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Admin" asp-action="Jobs">Jobs</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" asp-controller="Admin" asp-action="Courses">Courses</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link jn-nav-link" href="#">Statistics</a>
                    </li>
                </ul>

                <!-- Nhóm nút góc phải -->
                <div class="d-flex align-items-center">


                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Profile" asp-action="Index" class="text-white text-decoration-none me-3 fw-bold d-flex align-items-center">
                            <i class="bi bi-person-circle fs-5 me-1 text-warning"></i> @User.Identity.Name
                        </a>
                        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm rounded-pill px-3">Logout</a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
