@model IEnumerable<JobNow.Models.Course>

@{
    ViewData["Title"] = "Khóa Học";
}

<style>
    body {
        background-color: #F8FAFC;
    }

    .search-banner {
        background-color: #BED8FF;
        padding: 40px 0;
    }

    .filter-sidebar {
        background-color: white;
        border-radius: 8px;
        padding: 20px;
        border: 1px solid #e2e8f0;
    }

    .job-card {
        background-color: white;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        transition: border-color 0.3s;
        border-left: 4px solid transparent;
    }

        .job-card:hover {
            border-left: 4px solid #ff6b00;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

    .badge-tag {
        background-color: #f1f5f9;
        color: #475569;
        font-weight: 500;
    }

    .badge-hot {
        background-color: #000;
        color: #fff;
        font-size: 0.7rem;
    }

    .badge-new {
        background-color: #ffedd5;
        color: #ea580c;
        font-size: 0.7rem;
    }

    .text-orange {
        color: #ea580c;
    }

    .btn-apply {
        background-color: #ea580c;
        color: white;
        font-weight: bold;
    }

        .btn-apply:hover {
            background-color: #c2410c;
            color: white;
        }
</style>

<!-- Bọc tất cả vào Form để đồng bộ Bộ lọc trái và Thanh tìm kiếm trên -->
<form method="get" asp-controller="Course" asp-action="Index">

    <!-- Banner Tìm Kiếm -->
    <div class="search-banner mb-5">
        <div class="container">
            <h2 class="fw-bold mb-4" style="color: #1e293b;">Tìm kiếm khóa học để nâng cao năng lực chuyên môn của bạn</h2>
            <div class="bg-white p-2 rounded shadow-sm d-flex align-items-center">
                <div class="input-group border-end px-2" style="flex: 1;">
                    <span class="input-group-text bg-transparent border-0"><i class="text-muted">🎓</i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-0 shadow-none" placeholder="Nhập tên khóa học, kỹ năng...">
                </div>
                <div class="input-group px-2" style="flex: 1;">
                    <span class="input-group-text bg-transparent border-0"><i class="text-muted">📍</i></span>
                    <input type="text" name="location" value="@ViewBag.Location" class="form-control border-0 shadow-none" placeholder="Thành phố hoặc Online...">
                </div>
                <button type="submit" class="btn btn-apply px-4 py-2 rounded">🔍 Tìm Kiếm</button>
            </div>
        </div>
    </div>

    <div class="container mb-5">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger">Lỗi Database: @ViewBag.ErrorMessage</div>
        }

        <div class="row">
            <!-- CỘT TRÁI: BỘ LỌC -->
            <div class="col-md-3">
                <div class="filter-sidebar">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Bộ lọc</h5>
                        <a asp-action="Index" class="text-orange text-decoration-none small">Xóa tất cả</a>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary fw-bold small mb-3">THỜI GIAN HỌC</h6>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox">
                            <label class="form-check-label small">6 tháng</label>
                        </div>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" checked>
                            <label class="form-check-label small">1 năm</label>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary fw-bold small mb-3">CÁCH HỌC</h6>
                        <span class="badge bg-orange text-white rounded-pill px-3 py-2 me-1 mb-2" style="background-color: #ea580c;">ONLINE</span>
                        <span class="badge badge-tag rounded-pill px-3 py-2 me-1 mb-2">OFFLINE</span>
                    </div>

                    <div class="mb-4">
                        <h6 class="text-primary fw-bold small mb-3">MỨC GIÁ ($)</h6>
                        <div class="d-flex align-items-center mb-2">
                            <input type="number" name="minPrice" value="@ViewBag.MinPrice" class="form-control form-control-sm shadow-none" placeholder="Từ">
                            <span class="mx-2 text-muted fw-bold">-</span>
                            <input type="number" name="maxPrice" value="@ViewBag.MaxPrice" class="form-control form-control-sm shadow-none" placeholder="Đến">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100 mt-2 fw-bold">Áp dụng lọc</button>
                </div>
            </div>

            <!-- CỘT PHẢI: DANH SÁCH KHÓA HỌC -->
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p class="mb-0 text-muted">Hiển thị <strong class="text-dark">@ViewBag.TotalCourses</strong> khóa học phù hợp</p>
                    <div class="d-flex align-items-center">
                        <span class="small text-muted me-2 text-nowrap">Sắp xếp:</span>
                        <select class="form-select form-select-sm border-0 fw-bold shadow-none" style="background-color: transparent;">
                            <option>Mới nhất</option>
                            <option>Giá thấp nhất</option>
                        </select>
                    </div>
                </div>

                @foreach (var course in Model)
                {
                    <div class="job-card p-4 mb-3">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="d-flex">
                                <img src="@course.ProviderLogo" alt="Logo" class="rounded border me-3" style="width: 56px; height: 56px; object-fit: contain; padding: 4px;">
                                <div>
                                    <a asp-action="Detail" asp-controller="Course" asp-route-id="@course.Id" class="text-decoration-none text-dark">
                                        <h5 class="fw-bold mb-1 d-flex align-items-center">
                                            @course.Title
                                            @if (course.IsHot)
                                            {
                                                <span class="badge badge-hot ms-2 px-2 py-1">HOT</span>
                                            }
                                            @if (course.IsNew)
                                            {
                                                <span class="badge badge-new ms-2 px-2 py-1">MỚI</span>
                                            }
                                        </h5>
                                    </a>
                                    <p class="text-orange fw-bold small mb-0">@course.ProviderName</p>
                                </div>
                            </div>
                            <a href="#" class="text-orange fs-5"><i class="bi bi-bookmark"></i></a>
                        </div>

                        <div class="row text-muted small mb-3">
                            <div class="col-md-3"><strong>💵 $@course.Price</strong></div>
                            <div class="col-md-3">📍 @course.Location</div>
                            <div class="col-md-3">🕒 @course.PostedAt</div>
                            <div class="col-md-3 text-danger">⏳ Hạn đ.ký: @course.Deadline.ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                @if (!string.IsNullOrEmpty(course.Tags))
                                {
                                    foreach (var tag in course.Tags.Split(','))
                                    {
                                        <span class="badge badge-tag px-2 py-1 me-2">@tag.Trim()</span>
                                    }
                                }
                            </div>
                            <a asp-action="Detail" asp-controller="Course" asp-route-id="@course.Id" class="btn btn-apply px-4 py-1 text-decoration-none">
                                Xem chi tiết
                            </a>
                        </div>
                    </div>
                }

                <!-- Phân trang -->
                <nav class="mt-5">
                    <ul class="pagination justify-content-center">
                        @if (ViewBag.CurrentPage > 1)
                        {
                            <li class="page-item"><button type="submit" name="page" value="@(ViewBag.CurrentPage - 1)" class="page-link border-0 text-dark fw-bold">&laquo;</button></li>
                        }

                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item">
                                <button type="submit" name="page" value="@i" class="page-link border-0 fw-bold mx-1 rounded @(i == ViewBag.CurrentPage ? "text-white" : "text-dark")" style="@(i == ViewBag.CurrentPage ? "background-color: #ea580c;" : "")">@i</button>
                            </li>
                        }

                        @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                        {
                            <li class="page-item"><button type="submit" name="page" value="@(ViewBag.CurrentPage + 1)" class="page-link border-0 text-dark fw-bold">&raquo;</button></li>
                        }
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</form>