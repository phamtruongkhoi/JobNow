            </form>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 3: UPLOAD FILE CV (PDF/WORD) LÊN SUPABASE STORAGE
     ========================================================================= -->
<div class="modal fade" id="uploadCVModal" tabindex="-1" aria-labelledby="uploadCVModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="uploadCVModalLabel">Tải lên CV của bạn</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="UploadCV" asp-controller="Profile" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label for="cvInput" class="form-label fw-semibold">Chọn file CV từ thiết bị <span class="text-danger">*</span></label>
                        <input type="file" class="form-control" id="cvInput" name="cvFile" accept=".pdf,.doc,.docx" required />
                        <small class="text-muted d-block mt-2">
                            Hỗ trợ định dạng .PDF, .DOC, .DOCX. Dung lượng tối đa 10 MB.
                        </small>
                    </div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="isDefaultCheck" name="isDefault" value="true" @(Model.CVs.Count == 0 ? "checked" : "") />
                        <label class="form-check-label fw-semibold text-dark" for="isDefaultCheck">
                            Đặt làm CV mặc định ngay sau khi tải lên
                        </label>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jn-orange px-4">
                        <i class="bi bi-cloud-upload-fill me-1"></i> Tải lên và Lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- =========================================================================
     MODAL 4: AI TƯ VẤN CV (GOOGLE GEMINI AI - TYPEWRITER EFFECT)
     ========================================================================= -->
<div class="modal fade" id="aiAdviceModal" tabindex="-1" aria-labelledby="aiAdviceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0 pb-0 align-items-center">
                <div class="d-flex align-items-center gap-2">
                    <span class="fs-4 text-warning"><i class="bi bi-stars"></i></span>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="aiAdviceModalLabel">AI Tư vấn & Tối ưu CV</h5>
                        <small class="text-muted" id="aiModalSubtitle">Đánh giá dưới góc nhìn Chuyên gia HR từ Google Gemini AI</small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <div id="aiLoadingContainer" class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <h6 class="fw-bold text-dark">✨ Google Gemini AI đang đọc và đánh giá CV của bạn...</h6>
                    <p class="text-muted small mb-0">Quá trình này có thể mất từ 3 - 5 giây. Vui lòng đợi trong giây lát.</p>
                </div>

                <div id="aiErrorContainer" class="alert alert-danger d-none rounded-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> <span id="aiErrorText"></span>
                </div>

                <div id="aiResultContainer" class="d-none">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-purple text-white bg-opacity-75 rounded-pill px-3 py-1" style="background-color: #9333EA;">
                            <i class="bi bi-robot me-1"></i> Google Gemini AI HR Expert
                        </span>
                        <small class="text-muted"><i class="bi bi-check2-all text-success me-1"></i> Phân tích hoàn tất</small>
                    </div>
                    <div id="typewriterContent" class="typewriter-box shadow-sm"></div>
                </div>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-end">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Preview ảnh đại diện ngay khi chọn file
        function previewSelectedImage(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // =========================================================================
        // ĐIỀU HƯỚNG TAB & LƯU TRẠNG THÁI TRÊN CLIENT (SMOOTH TABS)
        // =========================================================================
        document.addEventListener('DOMContentLoaded', function () {
            const tabLinks = document.querySelectorAll('#profileTab .nav-link');
            const tabPanes = document.querySelectorAll('#profileTabContent .tab-pane');

            tabLinks.forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();
                    const targetId = this.getAttribute('data-bs-target');
                    activateTab(this, targetId);
                    localStorage.setItem('jn_active_profile_tab', targetId);
                });
            });

            const savedTabId = localStorage.getItem('jn_active_profile_tab');
            if (savedTabId) {
                const targetBtn = document.querySelector(`#profileTab .nav-link[data-bs-target="${savedTabId}"]`);
                if (targetBtn) {
                    activateTab(targetBtn, savedTabId);
                }
            }

            function activateTab(activeBtn, targetId) {
                tabLinks.forEach(btn => {
                    btn.classList.remove('active');
                    btn.setAttribute('aria-selected', 'false');
                });
                tabPanes.forEach(pane => {
                    pane.classList.remove('show', 'active');
                });

                activeBtn.classList.add('active');
                activeBtn.setAttribute('aria-selected', 'true');

                const activePane = document.querySelector(targetId);
                if (activePane) {
                    activePane.classList.add('show', 'active');
                }
            }
        });

        // Chuyển sang Tab "Settings" khi bấm Nút Chỉnh sửa
        function switchToEditTab() {
            var triggerEl = document.querySelector('#settings-tab');
            if (triggerEl) {
                triggerEl.click();
                triggerEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }

        // =========================================================================
        // GOOGLE GEMINI AI TƯ VẤN CV (AJAX + TYPEWRITER EFFECT)
        // =========================================================================
        let typewriterInterval = null;

        function analyzeCVWithAI(cvId, cvName) {
            var modalEl = document.getElementById('aiAdviceModal');
            var aiModal = new bootstrap.Modal(modalEl);
            
            document.getElementById('aiModalSubtitle').innerText = "Đang đánh giá tài liệu: " + cvName;
            document.getElementById('aiLoadingContainer').classList.remove('d-none');
            document.getElementById('aiErrorContainer').classList.add('d-none');
            document.getElementById('aiResultContainer').classList.add('d-none');
            document.getElementById('typewriterContent').innerHTML = "";
            if (typewriterInterval) clearInterval(typewriterInterval);
            
            aiModal.show();

            var formData = new FormData();
            formData.append('id', cvId);

            fetch('/Profile/AnalyzeCVWithAI', {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById('aiLoadingContainer').classList.add('d-none');
                if (data.success && data.advice) {
                    document.getElementById('aiResultContainer').classList.remove('d-none');
                    runTypewriterEffect(data.advice, document.getElementById('typewriterContent'));
                } else {
                    document.getElementById('aiErrorContainer').classList.remove('d-none');
                    document.getElementById('aiErrorText').innerText = data.message || "Không thể phân tích CV lúc này.";
                }
            })
            .catch(err => {
                document.getElementById('aiLoadingContainer').classList.add('d-none');
                document.getElementById('aiErrorContainer').classList.remove('d-none');
                document.getElementById('aiErrorText').innerText = "Lỗi kết nối máy chủ: " + err.message;
            });
        }

        function runTypewriterEffect(markdownText, element, speed = 8) {
            if (typewriterInterval) clearInterval(typewriterInterval);
            element.innerHTML = "";
            
            var formattedHtml = markdownText
                .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.*?)\*/g, '<em>$1</em>')
                .replace(/^### (.*$)/gim, '<h6 class="fw-bold text-primary mt-3 mb-1">$1</h6>')
                .replace(/^## (.*$)/gim, '<h5 class="fw-bold text-dark mt-3 mb-2">$1</h5>')
                .replace(/^# (.*$)/gim, '<h4 class="fw-bold text-dark mt-3 mb-2">$1</h4>')
                .replace(/^- (.*$)/gim, '<li class="mb-2 ms-3">$1</li>')
                .replace(/\n\n/g, '<br/><br/>')
                .replace(/\n/g, '<br/>');

            let index = 0;
            typewriterInterval = setInterval(() => {
                if (index < formattedHtml.length) {
                    if (formattedHtml.charAt(index) === '<') {
                        let closeIdx = formattedHtml.indexOf('>', index);
                        if (closeIdx !== -1) {
                            element.innerHTML += formattedHtml.substring(index, closeIdx + 1);
                            index = closeIdx + 1;
                            return;
                        }
                    }
                    element.innerHTML += formattedHtml.charAt(index);
                    index++;
                    element.scrollTop = element.scrollHeight;
                } else {
                    clearInterval(typewriterInterval);
                }
            }, speed);
        }
    </script>
}
