                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Ngày kết thúc</label>
                            <input type="date" name="EndDate" class="form-control rounded-3" />
                            <small class="text-muted">Để trống nếu bạn hiện vẫn đang làm việc tại đây.</small>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Mô tả công việc & Thành tựu</label>
                            <textarea name="Description" class="form-control rounded-3" rows="4" placeholder="Mô tả các trách nhiệm chính, công nghệ sử dụng và thành tựu nổi bật..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0 justify-content-end">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-jn-orange px-4">
                        <i class="bi bi-plus-circle me-1"></i> Thêm kinh nghiệm
                    </button>
