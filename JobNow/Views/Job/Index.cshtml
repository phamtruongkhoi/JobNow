@model IEnumerable<JobNow.Models.Job>

@{
    ViewData["Title"] = "Tìm Việc";

    // Lấy dữ liệu đã chọn từ Controller để giữ trạng thái
    var selectedExps = ViewBag.SelectedExperience as List<string> ?? new List<string>();
    var selectedTypes = ViewBag.SelectedJobType as List<string> ?? new List<string>();
}

@section Styles {
    <style>
        body {
            background-color: #F8FAFC;
        }

        .search-banner {
            background-color: #BED8FF;
            padding: 40px 0;
        }

        .filter-sidebar {
            background-color: white;
            border-radius: 8px;
            padding: 20px;
            border: 1px solid #e2e8f0;
        }

        .job-card {
            background-color: white;
            border: 1px solid #e2e8f0;
            border-radius: 8px;
            transition: border-color 0.3s;
        }

            .job-card:hover {
                border-color: #ff6b00;
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
            }

        .badge-tag {
            background-color: #f1f5f9;
            color: #475569;
            font-weight: 500;
        }

        .badge-hot {
            background-color: #000;
            color: #fff;
            font-size: 0.7rem;
        }

        .badge-new {
            background-color: #ffedd5;
            color: #ea580c;
            font-size: 0.7rem;
        }

        .text-orange {
            color: #ea580c;
        }

        .btn-apply {
            background-color: #ea580c;
            color: white;
            font-weight: bold;
        }

            .btn-apply:hover {
                background-color: #c2410c;
                color: white;
            }

        .form-check-input:checked {
            background-color: #ea580c;
            border-color: #ea580c;
        }

        /* CSS cho bộ lọc Loại công việc dạng Pill */
        .btn-check-custom + label {
            background-color: #f1f5f9;
            color: #475569;
            font-weight: 500;
            padding: 6px 16px;
            border-radius: 50px;
            cursor: pointer;
            font-size: 0.85rem;
            margin-right: 4px;
            margin-bottom: 8px;
            transition: all 0.2s;
        }

        .btn-check-custom:checked + label {
            background-color: #ea580c;
            color: white;
        }
    </style>
}

<!-- BỌC TẤT CẢ VÀO 1 FORM ĐỂ GỬI DỮ LIỆU ĐỒNG BỘ -->
<form method="get" asp-controller="Job" asp-action="Index">

    <!-- Banner Tìm Kiếm -->
    <div class="search-banner mb-5">
        <div class="container">
            <h2 class="fw-bold mb-4" style="color: #1e293b;">Tìm kiếm công việc mơ ước của bạn</h2>

            <div class="bg-white p-2 rounded shadow-sm d-flex align-items-center flex-wrap gap-2">
                <div class="input-group border-end px-2" style="flex: 1; min-width: 250px;">
                    <span class="input-group-text bg-transparent border-0"><i class="bi bi-briefcase-fill text-muted fs-5"></i></span>
                    <input type="text" name="keyword" value="@ViewBag.Keyword" class="form-control border-0 shadow-none" placeholder="Chức danh, từ khóa...">
                </div>
                <div class="input-group px-2" style="flex: 1; min-width: 250px;">
                    <span class="input-group-text bg-transparent border-0"><i class="bi bi-geo-alt-fill text-muted fs-5"></i></span>
                    <input type="text" name="location" value="@ViewBag.Location" list="locationList" class="form-control border-0 shadow-none" placeholder="Thành phố hoặc mã vùng..." autocomplete="off">
                    <!-- Danh sách gợi ý từ CSDL -->
                    <datalist id="locationList">
                        @if (ViewBag.Locations != null)
                        {
                            foreach (var loc in ViewBag.Locations)
                            {
                                <option value="@loc"></option>
                            }
                        }
                    </datalist>
                </div>
                <button type="submit" class="btn btn-apply px-4 py-2 rounded"><i class="bi bi-search me-1"></i> Tìm Kiếm</button>
            </div>
        </div>
    </div>

    <div class="container mb-5">
        @if (ViewBag.ErrorMessage != null)
        {
            <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill me-2"></i> Lỗi Database: @ViewBag.ErrorMessage</div>
        }

        <div class="row">
            <!-- CỘT TRÁI: BỘ LỌC -->
            <div class="col-md-3">
                <div class="filter-sidebar">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h5 class="fw-bold mb-0">Bộ lọc</h5>
                        <a asp-action="Index" class="text-orange text-decoration-none small">Xóa tất cả</a>
                    </div>

                    <!-- LỌC: KINH NGHIỆM -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold small mb-3">KINH NGHIỆM</h6>

                        @{
                            string[] expOptions = { "Thực tập sinh", "Mới tốt nghiệp", "1 - 3 năm", "3 - 5 năm" };
                        }
                        @for (int i = 0; i < expOptions.Length; i++)
                        {
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="experience" value="@expOptions[i]" id="exp_@i" @(selectedExps.Contains(expOptions[i]) ? "checked" : "")>
                                <label class="form-check-label small" for="exp_@i">@expOptions[i]</label>
                            </div>
                        }
                    </div>

                    <!-- LỌC: LOẠI CÔNG VIỆC -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold small mb-3">LOẠI CÔNG VIỆC</h6>

                        @{
                            string[] typeOptions = { "Toàn thời gian", "Bán thời gian", "Remote" };
                        }
                        @for (int i = 0; i < typeOptions.Length; i++)
                        {
                            <input type="checkbox" class="btn-check-custom d-none" name="jobType" value="@typeOptions[i]" id="type_@i" @(selectedTypes.Contains(typeOptions[i]) ? "checked" : "")>
                            <label for="type_@i" class="d-inline-block">@typeOptions[i]</label>
                        }
                    </div>

                    <!-- LỌC: MỨC LƯƠNG -->
                    <div class="mb-4">
                        <h6 class="text-primary fw-bold small mb-3">MỨC LƯƠNG (VNĐ)</h6>
                        <div class="d-flex align-items-center mb-2">
                            <input type="number" name="minSalary" value="@ViewBag.MinSalary" step="1000000" class="form-control form-control-sm shadow-none" placeholder="Từ" style="border-radius: 6px;">
                            <span class="mx-2 text-muted fw-bold">-</span>
                            <input type="number" name="maxSalary" value="@ViewBag.MaxSalary" step="1000000" class="form-control form-control-sm shadow-none" placeholder="Đến" style="border-radius: 6px;">
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100 mt-2 fw-bold">Áp dụng lọc</button>
                </div>
            </div>

            <!-- CỘT PHẢI: DANH SÁCH CÔNG VIỆC -->
            <div class="col-md-9">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <p class="mb-0 text-muted">Hiển thị <strong class="text-dark">@ViewBag.TotalJobs</strong> công việc phù hợp</p>
                    <div class="d-flex align-items-center">
                        <span class="small text-muted me-2 text-nowrap">Sắp xếp:</span>
                        <!-- ĐÃ CẬP NHẬT SELECT Ở ĐÂY -->
                        <select name="sortOrder" onchange="this.form.submit()" class="form-select form-select-sm border-0 fw-bold shadow-none" style="background-color: transparent;">
                            <!-- Dùng tính năng thông minh của Razor cho thuộc tính boolean -->
                            <option value="newest" selected="@(ViewBag.SortOrder != "salary_desc")">Mới nhất</option>
                            <option value="salary_desc" selected="@(ViewBag.SortOrder == "salary_desc")">Lương cao nhất</option>
                        </select>
                    </div>
                </div>

                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="bi bi-search text-muted" style="font-size: 3rem; opacity: 0.5;"></i>
                        <h5 class="mt-3 text-muted">Không tìm thấy công việc nào phù hợp với bộ lọc.</h5>
                    </div>
                }

                @foreach (var job in Model)
                {
                    var logoUrl = !string.IsNullOrEmpty(job.CompanyLogo)
                        ? job.CompanyLogo
                        : $"https://ui-avatars.com/api/?name={Uri.EscapeDataString(job.CompanyName ?? "Company")}&background=f1f5f9&color=ea580c";

                    <div class="job-card p-4 mb-3">
                        <div class="d-flex justify-content-between mb-3">
                            <div class="d-flex">
                                <img src="@logoUrl" alt="Logo" class="rounded border me-3" style="width: 56px; height: 56px; object-fit: contain; padding: 4px;">
                                <div>
                                    <h5 class="fw-bold mb-1 d-flex align-items-center">
                                        @job.Title
                                        @if (job.IsHot)
                                        {
                                            <span class="badge badge-hot ms-2 px-2 py-1"><i class="bi bi-fire text-warning"></i> HOT</span>
                                        }
                                        @if (job.IsNew)
                                        {
                                            <span class="badge badge-new ms-2 px-2 py-1">MỚI</span>
                                        }
                                    </h5>
                                    <p class="text-orange fw-bold small mb-0">@job.CompanyName</p>
                                </div>
                            </div>
                            <a href="#" class="text-orange fs-5" title="Lưu việc làm"><i class="bi bi-bookmark"></i></a>
                        </div>

                        <div class="row text-muted small mb-3 g-2">
                            <div class="col-md-3 text-success fw-bold"><i class="bi bi-cash-stack me-1"></i> @(job.Salary ?? "Thỏa thuận")</div>
                            <div class="col-md-3"><i class="bi bi-geo-alt me-1"></i> @job.Location</div>
                            <div class="col-md-3"><i class="bi bi-clock me-1"></i> @job.GetTimeAgo()</div>
                            <div class="col-md-3 text-danger"><i class="bi bi-hourglass-split me-1"></i> Hạn: @job.Deadline.ToString("dd/MM/yyyy")</div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <div>
                                @if (!string.IsNullOrEmpty(job.Tags))
                                {
                                    foreach (var tag in job.Tags.Split(','))
                                    {
                                        <span class="badge badge-tag px-2 py-1 me-2">@tag.Trim()</span>
                                    }
                                }
                            </div>
                            <a asp-controller="Job" asp-action="Details" asp-route-id="@job.Id" class="btn btn-apply px-4 py-2 text-decoration-none rounded-pill">
                                Ứng tuyển ngay
                            </a>
                        </div>
                    </div>
                }

                <!-- PHÂN TRANG -->
                @if (ViewBag.TotalPages > 1)
                {
                    <nav class="mt-5">
                        <ul class="pagination justify-content-center">
                            @if (ViewBag.CurrentPage > 1)
                            {
                                <li class="page-item">
                                    <button type="submit" name="page" value="@(ViewBag.CurrentPage - 1)" class="page-link border-0 text-dark fw-bold">&laquo;</button>
                                </li>
                            }

                            @for (int i = 1; i <= ViewBag.TotalPages; i++)
                            {
                                <li class="page-item">
                                    <button type="submit" name="page" value="@i" class="page-link border-0 fw-bold mx-1 rounded @(i == ViewBag.CurrentPage ? "text-white" : "text-dark")" style="@(i == ViewBag.CurrentPage ? "background-color: #ea580c;" : "")">@i</button>
                                </li>
                            }

                            @if (ViewBag.CurrentPage < ViewBag.TotalPages)
                            {
                                <li class="page-item">
                                    <button type="submit" name="page" value="@(ViewBag.CurrentPage + 1)" class="page-link border-0 text-dark fw-bold">&raquo;</button>
                                </li>
                            }
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</form>