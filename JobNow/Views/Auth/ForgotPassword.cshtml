@{
    Layout = null;
}
<!-- (Cậu copy nguyên cái cấu trúc HTML của trang VerifyOtp ở Bước 2, chỉ sửa lại chữ thành "Quên Mật Khẩu", form gửi một thẻ input tên là "email" đến action="ForgotPassword" là xong nhé!) -->
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<style>
    body {
        background-color: #bbd6fe;
        height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .auth-container {
        width: 100%;
        max-width: 400px;
        text-align: center;
    }

    .auth-title {
        color: white;
        font-weight: bold;
        font-size: 3rem;
        margin-bottom: 30px;
    }

    .form-control {
        border: none;
        border-radius: 0;
        padding: 12px;
        margin-bottom: 20px;
    }

    .form-label {
        color: #475569;
        font-weight: bold;
        text-align: left;
        display: block;
        margin-bottom: 5px;
    }

    .btn-orange {
        background-color: #ff6b00;
        color: white;
        font-weight: bold;
        border: none;
        padding: 10px 40px;
        border-radius: 4px;
    }
</style>
<div class="auth-container">
    <h1 class="auth-title">Quên Mật Khẩu</h1>
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger p-2">@ViewBag.Error</div>
    }
    <form asp-action="ForgotPassword" method="post">
        <div class="text-start">
            <label class="form-label">Nhập Gmail</label>
            <input type="email" name="email" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-orange mt-2">XÁC NHẬN</button>
    </form>
</div>