@model IEnumerable<JobNow.Models.Job>

@{
    ViewData["Title"] = "Quản lý Tin Tuyển Dụng";
}

<div class="row g-0">
    <div class="col-auto">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col" style="background-color: #f1f5f9; padding: 30px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold">Quản lý Tin Tuyển Dụng</h3>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-sm rounded-4">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm rounded-4">@TempData["ErrorMessage"]</div>
        }

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tiêu đề</th>
                            <th>Công ty</th>
                            <th>Lương</th>
                            <th>Ngày tạo</th>
                            <th>Trạng thái</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var job in Model)
                        {
                            <tr>
                                <td><div class="fw-bold">@job.Title</div><small class="text-muted">@job.Location</small></td>
                                <td>@job.CompanyName</td>
                                <td>@job.Salary</td>
                                <td>@(job.CreatedAt != DateTime.MinValue ? job.CreatedAt.ToString("dd/MM/yyyy") : job.PostedAt)</td>
                                <td>
                                    @if (job.Status == "Published")
                                    {
                                        <span class="badge bg-success">Đã duyệt</span>
                                    }
                                    else if (job.Status == "Rejected")
                                    {
                                        <span class="badge bg-danger">Từ chối</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">Đang chờ</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        @if (job.Status != "Published" && job.Status != "Rejected")
                                        {
                                            <form asp-action="ApproveJob" asp-route-id="@job.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Phê duyệt"><i class="bi bi-check-circle"></i> Duyệt</button>
                                            </form>
                                            <form asp-action="RejectJob" asp-route-id="@job.Id" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Từ chối"><i class="bi bi-x-circle"></i> Từ chối</button>
                                            </form>
                                        }
                                        <form asp-action="DeleteJob" asp-route-id="@job.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa tin này?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="Xóa"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
