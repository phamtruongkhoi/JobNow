@model IEnumerable<JobNow.Models.Profile>

@{
    ViewData["Title"] = "Quản lý Users";
}

<div class="row g-0">
    <div class="col-auto">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col" style="background-color: #f1f5f9; padding: 30px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold">Quản lý Users</h3>
        </div>

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Email</th>
                            <th>Họ tên</th>
                            <th>Số điện thoại</th>
                            <th>Vai trò</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Email</td>
                                <td>@(user.FullName ?? "N/A")</td>
                                <td>@(user.Phone ?? "N/A")</td>
                                <td>
                                    <span class="badge @(user.Role == "admin" ? "bg-danger" : "bg-primary")">@user.Role</span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
