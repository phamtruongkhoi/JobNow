@model IEnumerable<JobNow.Models.Employer>

@{
    ViewData["Title"] = "Quản lý Nhà Tuyển Dụng";
}

<div class="row g-0">
    <div class="col-auto">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col" style="background-color: #f1f5f9; padding: 30px;">
        <h3 class="fw-bold mb-4">Quản lý Nhà Tuyển Dụng</h3>

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Công ty</th>
                            <th>Email</th>
                            <th>Website</th>
                            <th>Quy mô</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var employer in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        @if (!string.IsNullOrEmpty(employer.LogoUrl))
                                        {
                                            <img src="@employer.LogoUrl" style="width:40px; height:40px; object-fit:contain;" class="me-2 rounded border p-1" />
                                        }
                                        <div class="fw-bold">@employer.Name</div>
                                    </div>
                                </td>
                                <td>@employer.Email</td>
                                <td><a href="@employer.Website" target="_blank">@employer.Website</a></td>
                                <td>@employer.CompanySize</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
