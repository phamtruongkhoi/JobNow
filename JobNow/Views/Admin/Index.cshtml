@model JobNow.ViewModels.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="row g-0">
    <div class="col-auto">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col" style="background-color: #f1f5f9; padding: 30px;">
        <h2 class="fw-bold mb-4">Dashboard</h2>

        <div class="row g-4">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                            <h6 class="text-muted fw-bold mb-0">Total Users</h6>
                        </div>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalUsers</h2>
                    </div>
                </div>
            </div>
            
            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-3 me-3">
                                <i class="bi bi-buildings fs-4"></i>
                            </div>
                            <h6 class="text-muted fw-bold mb-0">Total Employers</h6>
                        </div>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalEmployers</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 me-3">
                                <i class="bi bi-briefcase fs-4"></i>
                            </div>
                            <h6 class="text-muted fw-bold mb-0">Total Jobs</h6>
                        </div>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalJobs</h2>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center mb-3">
                            <div class="bg-info bg-opacity-10 text-info rounded-circle p-3 me-3">
                                <i class="bi bi-book fs-4"></i>
                            </div>
                            <h6 class="text-muted fw-bold mb-0">Total Courses</h6>
                        </div>
                        <h2 class="fw-bold mb-0 text-dark">@Model.TotalCourses</h2>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
