@model JobNow.ViewModels.AdminTokenTransactionsViewModel

@{
    ViewData["Title"] = "Quản lý Giao dịch Token";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="container-fluid p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold mb-0">Quản lý Giao dịch Token</h3>
        <div>
            <form asp-controller="Admin" asp-action="TokenTransactions" method="get" class="d-flex">
                <select name="filter" class="form-select me-2" onchange="this.form.submit()">
                    <option value="All" selected="@(Model.Filter == "All")">Tất cả</option>
                    <option value="Pending" selected="@(Model.Filter == "Pending")">Chờ duyệt</option>
                    <option value="Completed" selected="@(Model.Filter == "Completed")">Đã duyệt</option>
                    <option value="Rejected" selected="@(Model.Filter == "Rejected")">Đã từ chối</option>
                </select>
            </form>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Mã GD</th>
                            <th>Thời gian</th>
                            <th>Nhà tuyển dụng</th>
                            <th>Gói mua</th>
                            <th>Số tiền</th>
                            <th>Số Token</th>
                            <th>Trạng thái</th>
                            <th class="text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions != null && Model.Transactions.Any())
                        {
                            foreach (var item in Model.Transactions)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">#@item.Transaction.Id</td>
                                    <td>@item.Transaction.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <div class="fw-bold">@(item.Employer?.Name ?? "Không rõ")</div>
                                        <small class="text-muted">@(item.Employer?.Email ?? "")</small>
                                    </td>
                                    <td>
                                        <div class="badge bg-primary rounded-pill px-3 py-2">
                                            @(item.Package?.PackageName ?? "Token")
                                        </div>
                                    </td>
                                    <td class="fw-bold">
                                        @(item.Transaction.MoneyAmount?.ToString("N0") ?? "0") đ
                                    </td>
                                    <td class="text-success fw-bold">
                                        +@item.Transaction.TokenAmount
                                    </td>
                                    <td>
                                        @if (item.Transaction.Status == "Completed")
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Đã duyệt</span>
                                        }
                                        else if (item.Transaction.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                                        }
                                        else if (item.Transaction.Status == "Rejected")
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Từ chối</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Transaction.Status</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        @if (item.Transaction.Status == "Pending")
                                        {
                                            <form method="post" class="d-inline">
                                                <input type="hidden" name="id" value="@item.Transaction.Id" />
                                                <button type="submit" asp-controller="Admin" asp-action="ApproveTransaction" class="btn btn-sm btn-success rounded-pill px-3" onclick="return confirm('Xác nhận duyệt giao dịch này?');">
                                                    <i class="bi bi-check-lg"></i> Duyệt
                                                </button>
                                                <button type="submit" asp-controller="Admin" asp-action="RejectTransaction" class="btn btn-sm btn-danger rounded-pill px-3 ms-1" onclick="return confirm('Xác nhận từ chối giao dịch này?');">
                                                    <i class="bi bi-x-lg"></i> Từ chối
                                                </button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                                    Chưa có giao dịch mua Token nào
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
