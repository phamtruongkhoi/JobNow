@model IEnumerable<JobNow.Models.Course>

@{
    ViewData["Title"] = "Quản lý Khóa Học";
}

<div class="row g-0">
    <div class="col-auto">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col" style="background-color: #f1f5f9; padding: 30px;">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3 class="fw-bold">Quản lý Khóa Học</h3>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success shadow-sm rounded-4">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger shadow-sm rounded-4">@TempData["ErrorMessage"]</div>
        }

        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Tên khóa học</th>
                            <th>Trung tâm</th>
                            <th>Học phí</th>
                            <th>Thời lượng</th>
                            <th class="text-end">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var course in Model)
                        {
                            <tr>
                                <td><div class="fw-bold">@course.Title</div></td>
                                <td>@course.ProviderName</td>
                                <td>@course.Price</td>
                                <td>@course.Duration</td>
                                <td class="text-end">
                                    <form asp-action="DeleteCourse" asp-route-id="@course.Id" method="post" onsubmit="return confirm('Bạn có chắc chắn muốn xóa khóa học này?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Xóa</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
